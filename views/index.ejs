<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="login-body">
  <div class="background-animation">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>

  <div class="login-container">
    <div class="glass-card">
      <div class="logo">
        <h1>Nexus<span>Chat</span></h1>
      </div>
      <p class="subtitle">Enter your username to start chatting</p>
      
      <form action="/chat" method="GET" onsubmit="localStorage.setItem('username', document.getElementById('username').value)">
        <div class="input-group">
          <input type="text" id="username" name="username" placeholder="Enter Username..." required autocomplete="off">
        </div>
        <button type="submit" class="btn-primary">Enter Chat</button>
      </form>
    </div>
  </div>
</body>
</html>